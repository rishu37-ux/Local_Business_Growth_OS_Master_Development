# Copy to .env for local development. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Leave the DATABASE_URL_* unset to use libpq PG* variables with the role names.
# DATABASE_URL_APP=postgres://lbgos_app:...@host/db
# DATABASE_URL_PLATFORM=postgres://lbgos_platform:...@host/db
# DATABASE_URL_AUTH=postgres://lbgos_auth:...@host/db
TRUST_PROXY_HOPS=0
