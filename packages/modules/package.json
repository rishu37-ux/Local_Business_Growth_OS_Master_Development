{
  "name": "@lbgos/modules",
  "private": true,
  "type": "module",
  "description": "Business modules of the modular monolith; each module is imported only via its index.ts.",
  "exports": {
    "./agents": "./src/agents/index.ts",
    "./approvals": "./src/approvals/index.ts",
    "./audit": "./src/audit/index.ts",
    "./campaigns": "./src/campaigns/index.ts",
    "./auth": "./src/auth/index.ts",
    "./catalogue": "./src/catalogue/index.ts",
    "./channels": "./src/channels/index.ts",
    "./customers": "./src/customers/index.ts",
    "./expenses": "./src/expenses/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./inventory": "./src/inventory/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./messaging": "./src/messaging/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./ocr": "./src/ocr/index.ts",
    "./onboarding": "./src/onboarding/index.ts",
    "./outbound": "./src/outbound/index.ts",
    "./privacy": "./src/privacy/index.ts",
    "./purchasing": "./src/purchasing/index.ts",
    "./quotas": "./src/quotas/index.ts",
    "./reminders": "./src/reminders/index.ts",
    "./reports": "./src/reports/index.ts",
    "./sales": "./src/sales/index.ts",
    "./secrets": "./src/secrets/index.ts",
    "./studio": "./src/studio/index.ts",
    "./tenancy": "./src/tenancy/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:db": "scripts/check-auth-schema.sh"
  },
  "dependencies": {
    "@lbgos/db": "workspace:*",
    "@lbgos/domain": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.14",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
