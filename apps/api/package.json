    "@lbgos/domain": "workspace:*",
    "@lbgos/modules": "workspace:*",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "playwright": "1.63.0"
  }
}
